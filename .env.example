# Copy this file to .env.local and fill it in. The server checks these at startup and refuses to start if a
# required one is missing or malformed. "Optional" values can be left empty.

# --- App ---------------------------------------------------------------------------------------------
# The public origin of the app, with no trailing path. Every POST/PUT/PATCH/DELETE must come from this
# origin (CSRF check), and it's used to build links in emails and the Google callback. In production set
# it to your real address (e.g. https://scratchpad.example.com) and redeploy if it changes.
APP_URL=http://localhost:3000

# --- Database ----------------------------------------------------------------------------------------
# Local: docker run -d -p 27017:27017 --name dsa-mongo mongo:8
# Hosted: a MongoDB Atlas connection string (mongodb+srv://...). Required.
MONGODB_URI=mongodb://127.0.0.1:27017/dsa-viz

# --- Sessions ----------------------------------------------------------------------------------------
# Two different random strings of 32+ characters used to sign the login cookies: `openssl rand -base64 48`
# Changing them logs everyone out. Required.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Token lifetimes (optional: leave empty for the defaults). A number plus s, m, h, d or w; a bare number
# is seconds. The refresh token is renewed on every refresh, so its lifetime is how long someone can stay
# away before having to log in again.
ACCESS_TOKEN_TTL=             # e.g. 15m (default 15m)
REFRESH_TOKEN_TTL=            # e.g. 30d (default 7d)

# --- Encryption --------------------------------------------------------------------------------------
# Encrypts users' own AI provider API keys at rest (AES-256-GCM). Exactly 32 random bytes, base64:
# `openssl rand -base64 32`. Required. Keep it safe and don't change it, or stored API keys can no longer
# be decrypted and users have to enter them again.
ENCRYPTION_KEY=
# Saved next to each encrypted value so the key can be rotated later. Leave at 1 unless you rotate.
ENCRYPTION_KEY_VERSION=1

# --- Email -------------------------------------------------------------------------------------------
# Verification and password-reset codes are sent with nodemailer over SMTP. Needed in production: without
# SMTP_USER/SMTP_PASS sending fails. In development, leave them empty to print the codes to the server
# console instead.
# Gmail: turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465                 # 465 = implicit TLS; 587 = STARTTLS
SMTP_USER=                    # e.g. you@gmail.com
SMTP_PASS=                    # the 16-character app password, not your Google password
EMAIL_FROM=                   # e.g. ScratchPad <you@gmail.com> (defaults to ScratchPad <SMTP_USER>)

# --- Notebook photo uploads: Cloudflare R2 (optional) --------------------------------------------------
# Leave these four empty to disable image uploads; the rest of the app works. The bucket also needs a CORS
# rule that allows PUT/GET from your APP_URL (see the README).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional public base URL of the bucket. When set, images are served from it (anyone with a link can
# read them); when empty, they're served through short-lived presigned links from a private bucket.
# e.g. https://pub-xxxx.r2.dev (rate-limited, fine for trying it out) or https://cdn.example.com
R2_PUBLIC_URL=

# --- Log in with Google (optional) -------------------------------------------------------------------
# Leave both empty to hide the button.
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Usage limits (optional) -------------------------------------------------------------------------
# How many times per hour each learner can run the actions that spend their own AI key. Leave empty for
# the defaults; 0 turns a limit off (handy for local testing). A run that fails doesn't count. The counters
# are held in server memory, so a restart resets them, and each server instance counts separately.
RATE_LIMIT_ATTEMPTS_PER_HOUR=     # analysing pseudo-code (default 10)
RATE_LIMIT_SOLUTIONS_PER_HOUR=    # writing solutions (default 6)
RATE_LIMIT_MESSAGES_PER_HOUR=     # chat messages (default 30)

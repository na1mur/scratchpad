MONGODB_URI=mongodb://127.0.0.1:27017/dsa-viz
JWT_ACCESS_SECRET=            # 32+ random bytes, e.g. `openssl rand -base64 48`
JWT_REFRESH_SECRET=           # different 32+ random bytes
# Token lifetimes (optional: leave empty for the defaults). Units: s, m, h, d, w.
ACCESS_TOKEN_TTL=             # e.g. 15m (default 15m)
REFRESH_TOKEN_TTL=            # e.g. 30d (default 7d); renewed on every refresh
ENCRYPTION_KEY=               # 32 bytes, base64 (AES-256-GCM): `openssl rand -base64 32`
ENCRYPTION_KEY_VERSION=1
# Cloudflare R2 (optional: leave empty to disable notebook image uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=                # optional, e.g. https://pub-xxxx.r2.dev or https://cdn.example.com
APP_URL=http://localhost:3000
# Email (verification and password-reset codes), sent with nodemailer over SMTP.
# Gmail: turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
# Leave SMTP_USER/SMTP_PASS empty in development to print codes to the server console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465                 # 465 = implicit TLS; 587 = STARTTLS
SMTP_USER=                    # e.g. you@gmail.com
SMTP_PASS=                    # the 16-character app password, not your Google password
EMAIL_FROM=                   # e.g. Scratchpad <you@gmail.com> (defaults to SMTP_USER)
# Log in with Google (optional: leave empty to hide the button).
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
